# Standard 26.3 LAN setup uses ViaProxy locally. This endpoint is the proxy, NOT the LAN server.
MC_HOST=127.0.0.1
MC_PORT=25568
MC_VERSION=26.1
# With ViaProxy, use offline auth on the local proxy leg. ViaProxy authenticates to the real server.
MC_AUTH=offline
MC_USERNAME=CompanionBot
# The exact Minecraft username of the authorized human player (case-sensitive).
MC_OWNER=YourExactMinecraftName
# Count of automatic retries after an unexpected disconnect (not after a kick/auth failure).
MC_RECONNECT_ATTEMPTS=3
# Delay between accepted bot chat responses, in milliseconds.
MC_CHAT_COOLDOWN_MS=1200
